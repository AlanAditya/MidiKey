{
  "name": "medikey",
  "private": true,
  "version": "1.0.0",
  "description": "MediKey \u2013 zero-trust medical record aggregator. Client-side keys, PII redaction, encrypted sharing.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n relay,web -c magenta,cyan \"npm:relay\" \"vite\"",
    "relay": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && node server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "mock-ipfs": "node scripts/mock-ipfs.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "express": "^5.2.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.47.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/express": "^5.0.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
